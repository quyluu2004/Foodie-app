# ─────────────────────────────────────────────────────────────
# Foodie Backend — copy thành file: .env
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ─── Bắt buộc ─────────────────────────────────────────────────
# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/foodie

# Secret ký JWT — tối thiểu 32 ký tự (không commit giá trị thật)
# Gợi ý: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_CHAR_RANDOM_HEX_OR_STRING

# ─── Tùy chọn — JWT ───────────────────────────────────────────
# Nếu không đặt, server sẽ tự gán: JWT_SECRET + "_refresh"
# JWT_REFRESH_SECRET=

# ─── Tùy chọn — Server ──────────────────────────────────────
NODE_ENV=development
PORT=8080

# Production: danh sách origin CORS, phân tách bằng dấu phẩy
# ALLOWED_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# ─── Tùy chọn — Cloudinary (upload ảnh/video) ────────────────
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ─── Tùy chọn — Google Gemini (AI trong app) ────────────────
# GEMINI_API_KEY=

# ─── Tùy chọn — Email (SMTP, ví dụ Gmail app password) ───────
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=
# EMAIL_PASSWORD=

# ─── Tùy chọn — script / maintenance ────────────────────────
# UNSPLASH_ACCESS_KEY=
